<?xml version="1.0"?>
<!--
  阶段 1 机械臂组成：UR5e + Robotiq 2F-85，安装于工作台世界。

  设计意图（参见 docs/decisions/ADR-0004-arm-selection.md 与 PLAN.md 阶段 1）：

  - 工作台静态几何（桌子、托盘、模块、相机）是世界坐标系的权威来源；我们通过
    `xacro:include` 引入它，绝不在本文件重新定义其中任何部分。
  - 我们引入厂商包的*宏*（而非它们的顶层 `ur.urdf.xacro` / 独立夹爪 URDF），因为
    那些顶层文件会声明各自的 `world` 连杆。引入宏可以保证恰好只有一个 `world` 连杆
    — 即工作台的那一个。
  - 每个机械臂特有标识符与底座位姿都是 xacro 参数，其默认值与 config/arm.yaml 镜像
    一致。替换机械臂只是改配置，从不改适配器逻辑（阶段 1 验收闸门 + README 替换
    清单）。

  ros2_control 通过 sim_gz:=true 选择启用。默认保持 false，使阶段 1 的 MoveIt/可达性
  展开完全不包含控制插件。

  验证方法：
    xacro robot/control/config/arm_on_workbench.urdf.xacro > /tmp/wb_arm.urdf
    check_urdf /tmp/wb_arm.urdf
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="workbench_arm">

  <!-- ==================================================== 替换面参数 -->
  <!-- 默认值必须与 config/arm.yaml 一致。这些是后续替换机械臂时唯一需要改动的
       旋钮。 -->
  <xacro:arg name="ur_type"        default="ur5e"/>
  <xacro:arg name="tf_prefix"      default=""/>
  <xacro:arg name="sim_gz"         default="false"/>
  <xacro:arg name="driver_joint"   default="robotiq_85_left_knuckle_joint"/>
  <xacro:arg name="controllers_yaml" default="$(find workbench_motion)/config/controllers.yaml"/>

  <!-- 机械臂底座在工作台 `world` 坐标系中的安装位置。机械臂安装于桌面（world z =
       table_height = 0.75），朝 -y 方向偏移并偏航以面向方块+托盘中心。根据可达性
       闸门（reachability_check 控制台脚本）调优：该位姿以 100% 通过两个区域，而更
       靠后角的位姿会让托盘处于可达极限并产生碰撞路径。参见 ADR-0004。 -->
  <xacro:arg name="base_x"   default="-0.30"/>
  <xacro:arg name="base_y"   default="-0.15"/>
  <xacro:arg name="base_z"   default="0.75"/>
  <xacro:arg name="base_yaw" default="0.36"/>

  <!-- 抓取 TCP：IK 末端坐标系。固定于 tool0，沿 tool0 +z 偏移一个夹爪叠层长度，使
       位姿指定在手指之间的抓取点而非腕部。约 0.16 m ≈ 适配器 + Robotiq 2F-85
       底座→指尖。阶段 1 可达性用近似值；阶段 5 用 grasp.yaml 细化。 -->
  <xacro:arg name="tcp_z"    default="0.16"/>

  <!-- 工作台静态世界 xacro 的路径。`robot/description` 不是 ROS 包（没有
       package.xml；按 FRAMES.md，Owner 不同、评审路径不同），因此 `$(find
       robot_description)` 无法解析它。于是 setup.py 在构建时把世界 xacro 的一份副本
       内置到本包的 share 目录下，即
       `workbench_motion/description/workbench.urdf.xacro`，这样在
       `colcon build && source install/setup.bash` 之后，`$(find workbench_motion)`
       能在源码空间与安装空间一致地解析它。若启动调试时把世界 xacro 装到了别处，可
       覆盖该参数。 -->
  <xacro:arg name="workbench_xacro" default="$(find workbench_motion)/description/workbench.urdf.xacro"/>

  <!-- =============================================== 工作台静态世界 -->
  <!-- 桌子 / 托盘 / 模块 / 相机及 `world` 连杆的权威来源。 -->
  <xacro:include filename="$(arg workbench_xacro)"/>

  <!-- ============================================================ UR5e 机械臂 -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <xacro:ur_robot
    name="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml">
    <origin xyz="$(arg base_x) $(arg base_y) $(arg base_z)" rpy="0 0 $(arg base_yaw)"/>
  </xacro:ur_robot>

  <!-- ================================================= Robotiq 2F-85 夹爪 -->
  <!-- UR 出厂不带夹爪（ADR-0004）。经由官方 UR→Robotiq 适配器安装到 tool0，再把
       2F-85 宏挂在适配器的安装连杆上。 -->
  <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>

  <xacro:ur_to_robotiq prefix="$(arg tf_prefix)" connected_to="$(arg tf_prefix)tool0"/>

  <xacro:robotiq_gripper
    name="RobotiqGripperHardware"
    prefix="$(arg tf_prefix)"
    parent="$(arg tf_prefix)gripper_mount_link"
    include_ros2_control="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <!-- ==================================================== 抓取 TCP（IK 末端） -->
  <link name="$(arg tf_prefix)grasp_tcp"/>
  <joint name="$(arg tf_prefix)tool0_to_grasp_tcp" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child  link="$(arg tf_prefix)grasp_tcp"/>
    <origin xyz="0 0 $(arg tcp_z)" rpy="0 0 0"/>
  </joint>

  <!-- ==================================================== 仿真控制 -->
  <xacro:if value="$(arg sim_gz)">
    <xacro:include filename="$(find workbench_motion)/config/ros2_control.xacro"/>
    <xacro:workbench_ros2_control
      tf_prefix="$(arg tf_prefix)"
      driver_joint="$(arg driver_joint)"
      controllers_yaml="$(arg controllers_yaml)"/>
  </xacro:if>

</robot>
