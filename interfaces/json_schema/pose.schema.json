{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pose",
  "description": "命名坐标系中的刚体位姿。位置单位为米，姿态为单位四元数。",
  "type": "object",
  "required": ["frame_id", "position", "orientation"],
  "properties": {
    "frame_id": {"type": "string"},
    "position": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "orientation": {
      "type": "object",
      "required": ["x", "y", "z", "w"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"},
        "w": {"type": "number"}
      }
    }
  }
}
