{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldEvent",
  "description": "只追加事件。按 sequence_no 顺序回放同一事件流，必须复现完全一致的 WorldState 哈希。",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "sequence_no",
    "event_type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "sequence_no": {
      "type": "integer",
      "minimum": 0
    },
    "event_type": {
      "enum": [
        "observation",
        "action_request",
        "action_result",
        "verification",
        "fault",
        "emotion",
        "task_accepted",
        "task_terminal",
        "task_start",
        "tool_call",
        "policy_violation",
        "recovery_started",
        "recovery_complete"
      ]
    },
    "payload": {
      "type": "object"
    },
    "occurred_at": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string"
    },
    "clock_id": {
      "enum": [
        "monotonic",
        "wall"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
