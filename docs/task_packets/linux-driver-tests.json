{
  "issue": "LINUX9",
  "human_owner": "Quchaosheng",
  "objective": "让 wbcan 驱动测试套件产出经过校验、机器可读的证据，由 CI 归档，且不把跳过或部分执行当作通过。",
  "allowed_paths": [
    "kernel/wbcan/test_wbcan.sh",
    "kernel/wbcan/validate_test_report.py",
    ".github/workflows/ci.yml",
    "tests/unit/test_linux_driver_tests.py",
    "tests/unit/test_release_workflow.py",
    "docs/task_packets/linux-driver-tests.json"
  ],
  "read_only_paths": [
    "firmware/**",
    "interfaces/**",
    "robot/control/**",
    "AGENTS.md"
  ],
  "forbidden": [
    "firmware/**",
    "interfaces/**",
    "robot/control/**"
  ],
  "acceptance": [
    "每条 wbcan 断言都以唯一测试 id、期望值与实际值记录",
    "报告验证器拒绝缺失、格式错误、重复或失败的行，并强制执行最小检查次数",
    "即使特权套件失败，CI 仍校验并上传报告",
    "当报告缺失或不完整时，CI 不得报告结构化套件通过",
    "报告仍属软件驱动证据，不声称物理吞吐量、延迟或抖动"
  ],
  "commands": [
    "python -m pytest tests/unit/test_linux_driver_tests.py tests/unit/test_release_workflow.py -v",
    "make -C kernel/wbcan",
    "make -C kernel/wbcan checkpatch",
    "sudo make -C kernel/wbcan test",
    "git diff --check"
  ],
  "evidence": [
    "报告校验与 CI 接线的单元测试输出",
    "内核模块构建与 checkpatch 输出",
    "特权 wbcan 套件输出",
    "上传的 wbcan-driver-test-report 制品"
  ],
  "stop_conditions": [
    "托管运行器无法执行特权内核模块测试",
    "需要物理 CAN 控制器或硬件性能测量",
    "该变更需要写入固件、接口或机器人控制"
  ]
}
