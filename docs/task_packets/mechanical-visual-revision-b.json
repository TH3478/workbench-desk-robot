  "acceptance": [
    "Revision B 保持 280 x 240 x 330 mm 包络、260 x 220 mm 底盘、18 mm 离地间隙、150 x 72 mm 显示屏开孔与 PCB 安装孔型",
    "SCAD 与 CadQuery 生成器描述相同的产品级结构：低底盘、收窄肩部外壳、独立 8 度头部、内凹显示屏边框、轮舱、角部防撞条、走线槽与服务面板",
    "解析稳定性、托盘适配、跌落筛选与物理验证状态保持显式，并通过现有机械检查",
    "生成的总布置证据指明 Revision B 几何，且不声称物理验证",
    "产品主视觉使用 Revision B 轮廓，且不描绘旧的透明箱体几何",
    "机械包测试、产物生成、Ruff 与任务包校验通过"
  ],
  "commands": [
    "python hardware/mechanical/tools/generate_artifacts.py",
    "python -m unittest tests.hardware.test_engineering_packages -v",
    "python -m unittest tests.hardware.test_operations_readiness -v",
    "python -m ruff check hardware/mechanical tests/hardware/test_engineering_packages.py",
    "python tools/scripts/check_task_packet.py docs/task_packets/mechanical-visual-revision-b.json"
  ],
  "evidence": [
    "hardware/mechanical/design-spec.json",
    "hardware/mechanical/cad/desk_robot.scad",
